# Copy to backend/.env (git-ignored) or set these in your cloud host.
# Only needed for the "supabase" profile; the default "dev" profile uses H2.
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<your-database-password>
# Set to "always" for ONE start to (re)create and seed the tables, then back to "never"
DB_INIT_MODE=never
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
